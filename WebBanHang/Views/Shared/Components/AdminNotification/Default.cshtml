@model int
<a class="dashboard-icon-btn"
   asp-area="Admin"
   asp-controller="OverdueReport"
   asp-action="Index"
   title="Phiếu mượn quá hạn"
   aria-label="Thông báo quá hạn (@Model)">
    <i class="bi bi-bell"></i>
    @if (Model > 0)
    {
        <span class="badge text-bg-danger rounded-pill">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
