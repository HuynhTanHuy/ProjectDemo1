@model IEnumerable<WebBanHang.Models.Category>
@using WebBanHang.Models.ViewModels

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">Categories List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Category
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td class="text-end">
                        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminActionButtons.cshtml", new AdminActionButtonsViewModel
                        {
                            Controller = "Categories",
                            Id = obj.Id,
                            ShowDetail = false
                        })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div> 