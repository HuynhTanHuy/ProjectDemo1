@model WebBanHang.Models.ViewModels.BookCopyIndexViewModel
@using WebBanHang.Models
@{
    ViewData["Title"] = "Bản sao sách";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0 fw-semibold">
        <i class="bi bi-journals me-2 text-primary"></i>Bản sao sách
    </h1>
    <a asp-area="Admin" asp-controller="LibraryQr" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-qr-code-scan me-1"></i>QR &amp; kiểm kê
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="BookCopies" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small text-muted mb-1" for="q">Tìm kiếm</label>
                <input type="text" class="form-control form-control-sm" id="q" name="SearchQuery" value="@Model.SearchQuery" placeholder="Mã bản sao hoặc tên sách..." />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1" for="ps">Trạng thái vật lý</label>
                <select class="form-select form-select-sm" id="ps" name="PhysicalStatus" asp-items="Model.PhysicalStatusOptions"></select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1" for="pageSize">/ trang</label>
                <select class="form-select form-select-sm" id="pageSize" name="PageSize" asp-for="PageSize">
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <input type="hidden" name="PageNumber" value="1" />
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Lọc</button>
                <a asp-area="Admin" asp-controller="BookCopies" asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã bản sao</th>
                    <th>Tên sách</th>
                    <th>QR</th>
                    <th>Vị trí kệ</th>
                    <th>Trạng thái</th>
                    <th>Người mượn</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">Không có bản sao phù hợp.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><code>@item.CopyCode</code></td>
                        <td>@item.BookTitle</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.QrImageRelativeUrl))
                            {
                                <img src="@item.QrImageRelativeUrl" alt="QR @item.CopyCode" class="border rounded" style="width:48px;height:48px;object-fit:contain" />
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(item.ShelfLocation) ? "—" : item.ShelfLocation)</td>
                        <td>
                            @switch (item.PhysicalStatus)
                            {
                                case BookCopyStatus.Lost:
                                    <span class="badge bg-danger">Mất</span>
                                    break;
                                case BookCopyStatus.Disposed:
                                    <span class="badge bg-dark">Thanh lý</span>
                                    break;
                                default:
                                    <span class="badge @(item.BorrowStatusText.StartsWith("Đang") ? "bg-primary" : "bg-success")">@item.BorrowStatusText</span>
                                    break;
                            }
                        </td>
                        <td>@(item.BorrowedByFullName ?? item.BorrowedByUserName ?? "—")</td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrEmpty(item.QrImageRelativeUrl))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="BookCopies" asp-action="DownloadQr" asp-route-id="@item.BookCopyId" title="Tải QR">
                                    <i class="bi bi-download"></i>
                                </a>
                            }
                            <form asp-area="Admin" asp-controller="BookCopies" asp-action="RegenerateQr" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookCopyId" value="@item.BookCopyId" />
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Tạo lại QR">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 0 && Model.TotalCount > 0)
    {
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
            <div class="small text-muted">
                Hiển thị @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) / @Model.TotalCount.ToString("N0") bản sao
            </div>
            <nav aria-label="Phân trang">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-area="Admin" asp-controller="BookCopies" asp-action="Index"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SearchQuery="@Model.SearchQuery"
                           asp-route-PhysicalStatus="@Model.PhysicalStatus">Trước</a>
                    </li>
                    @{
                        var start = Math.Max(1, Model.PageNumber - 2);
                        var end = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                        for (var p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                                <a class="page-link" asp-area="Admin" asp-controller="BookCopies" asp-action="Index"
                                   asp-route-PageNumber="@p"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-SearchQuery="@Model.SearchQuery"
                                   asp-route-PhysicalStatus="@Model.PhysicalStatus">@p</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-area="Admin" asp-controller="BookCopies" asp-action="Index"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SearchQuery="@Model.SearchQuery"
                           asp-route-PhysicalStatus="@Model.PhysicalStatus">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<p class="small text-muted mt-3 mb-0">
    Gán vị trí kệ, đánh dấu mất hoặc thanh lý: quét QR tại trang <a asp-area="Admin" asp-controller="LibraryQr" asp-action="Index">QR &amp; kiểm kê</a>.
</p>
