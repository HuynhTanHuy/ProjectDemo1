@using System.Globalization
@using WebBanHang.Models
@using WebBanHang.Models.ViewModels
@model IEnumerable<WebBanHang.Models.Order>

<div class="admin-page-card p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="h4 mb-0">
            <i class="bi bi-cart-check me-2"></i>Quản lý Đơn hàng
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Người đặt</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Địa chỉ giao hàng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Id</td>
                        <td>@obj.ApplicationUser?.UserName</td>
                        <td>@obj.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@obj.TotalPrice.ToString("c", new CultureInfo("vi-VN"))</td>
                        <td>
                            @if (obj.OrderStatus == OrderStatus.Pending)
                            { <span class="badge bg-warning">Chờ thanh toán</span> }
                            else if (obj.OrderStatus == OrderStatus.Paid)
                            { <span class="badge bg-success">Đã thanh toán</span> }
                            else if (obj.OrderStatus == OrderStatus.Shipping)
                            { <span class="badge bg-info">Đang giao</span> }
                            else if (obj.OrderStatus == OrderStatus.Completed)
                            { <span class="badge bg-primary">Hoàn tất</span> }
                            else if (obj.OrderStatus == OrderStatus.Cancelled)
                            { <span class="badge bg-secondary">Đã hủy</span> }
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@obj.ShippingAddress">
                                @obj.ShippingAddress
                            </span>
                        </td>
                        <td class="text-end">
                            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminActionButtons.cshtml", new AdminActionButtonsViewModel
                            {
                                Controller = "Orders",
                                Id = obj.Id
                            })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
