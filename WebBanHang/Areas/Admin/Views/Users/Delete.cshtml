@model WebBanHang.Models.ViewModels.UserDetailViewModel
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="dash-form-card card border-danger border-2">
            <div class="card-body">
                <h2 class="h5 text-danger mb-3"><i class="bi bi-trash-fill me-2"></i>Xóa tài khoản</h2>
                <p>Bạn có chắc muốn xóa tài khoản <strong>@Model.UserName</strong> (@Model.FullName)?</p>
                <p class="small text-muted mb-4">Không thể xóa nếu còn phiếu mượn đang hoạt động. Không thể xóa chính mình.</p>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash-fill me-1"></i>Xác nhận xóa
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
