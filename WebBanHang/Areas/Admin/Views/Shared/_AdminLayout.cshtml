@using WebBanHang.Models
@{
    var nav = ViewData["AdminNavSection"] as string ?? "";
    var pageTitle = ViewData["AdminPageTitle"] as string ?? ViewData["Title"] as string ?? "Quản trị";
    var breadcrumb = ViewData["AdminBreadcrumb"] as string ?? "";
}
<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/shared-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @{
        ViewData["ThemeDefault"] = "dark";
        ViewData["ThemePendingDark"] = true;
    }
    @await Html.PartialAsync("_ThemeInitHead")
</head>
<body class="dashboard-body dark-mode">
    @await Html.PartialAsync("_ThemeInitBody")
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <a class="dashboard-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">Thư viện</a>
            <nav>
                <div class="dashboard-nav-section">
                    <div class="dashboard-nav-heading">Tổng quan</div>
                    <a class="dashboard-nav-link @(nav == "overview" ? "is-active" : null)" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Bảng điều khiển
                    </a>
                </div>
                <div class="dashboard-nav-section">
                    <div class="dashboard-nav-heading">Sách</div>
                    <a class="dashboard-nav-link @(nav == "books" ? "is-active" : null)" asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-book-half"></i> Danh sách sách
                    </a>
                    <a class="dashboard-nav-link @(nav == "borrows" ? "is-active" : null)" asp-area="Admin" asp-controller="Borrows" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i> Mượn &amp; trả
                    </a>
                    <a class="dashboard-nav-link @(nav == "book_copies" ? "is-active" : null)" asp-area="Admin" asp-controller="BookCopies" asp-action="Index">
                        <i class="bi bi-journals"></i> Bản sao sách
                    </a>
                    <a class="dashboard-nav-link @(nav == "library_settings" ? "is-active" : null)" asp-area="Admin" asp-controller="LibrarySettings" asp-action="Index">
                        <i class="bi bi-sliders"></i> Cấu hình mượn
                    </a>
                    <a class="dashboard-nav-link @(nav == "overdue_report" ? "is-active" : null)" asp-area="Admin" asp-controller="OverdueReport" asp-action="Index">
                        <i class="bi bi-exclamation-triangle"></i> Báo cáo quá hạn
                    </a>
                    <a class="dashboard-nav-link @(nav == "library_qr" ? "is-active" : null)" asp-area="Admin" asp-controller="LibraryQr" asp-action="Index">
                        <i class="bi bi-qr-code-scan"></i> QR &amp; kiểm kê
                    </a>
                </div>
                <div class="dashboard-nav-section">
                    <div class="dashboard-nav-heading">Thành viên</div>
                    <a class="dashboard-nav-link @(nav == "members" ? "is-active" : null)" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Tài khoản
                    </a>
                </div>
                <div class="dashboard-nav-section">
                    <div class="dashboard-nav-heading">Giao dịch</div>
                    <a class="dashboard-nav-link @(nav == "orders" ? "is-active" : null)" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-bag-check-fill"></i> Đơn hàng
                    </a>
                    <a class="dashboard-nav-link @(nav == "penalties" ? "is-active" : null)" asp-area="Admin" asp-controller="Penalties" asp-action="Index">
                        <i class="bi bi-cash-coin"></i> Phạt &amp; nợ
                    </a>
                    <a class="dashboard-nav-link @(nav == "payment_tx" ? "is-active" : null)" asp-area="Admin" asp-controller="PaymentTransactions" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Nhật ký thanh toán
                    </a>
                </div>
            </nav>
            <div class="dashboard-sidebar-footer">
                <a class="btn btn-outline-light btn-sm w-100" href="@Url.Action("Index", "Home", new { area = "Customer", tab = "products" })">
                    <i class="bi bi-shop-window me-2"></i>Cửa hàng
                </a>
            </div>
        </aside>
        <div class="dashboard-main">
            <header class="dashboard-header">
                <div class="dashboard-header-titles">
                    <h1>@pageTitle</h1>
                    @if (!string.IsNullOrEmpty(breadcrumb))
                    {
                        <p class="dashboard-breadcrumb">@breadcrumb</p>
                    }
                </div>
                <div class="dashboard-header-actions ui-header-actions">
                    @await Component.InvokeAsync("AdminNotification")
                    @await Html.PartialAsync("_ThemeToggle")
                    @await Component.InvokeAsync("AdminUserMenu")
                </div>
            </header>
            <main class="dashboard-content">
                @if (TempData["Success"] != null || TempData["success"] != null)
                {
                    <div class="alert alert-success dashboard-alert">@(TempData["Success"] ?? TempData["success"])</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger dashboard-alert">@TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
