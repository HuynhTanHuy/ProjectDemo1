@model WebBanHang.Models.ViewModels.BorrowIndexViewModel
@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var totalFine = (decimal)(ViewBag.TotalFine ?? 0m);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Báo cáo quá hạn</h2>
    <div class="text-danger fw-semibold">Tổng phạt ước tính: @totalFine.ToString("N0") đ</div>
</div>
<div class="table-responsive card">
    <table class="table table-sm table-hover mb-0">
        <thead><tr><th>Người mượn</th><th>Sách</th><th>Hạn trả</th><th>Ngày trễ</th><th class="text-end">Phạt</th></tr></thead>
        <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.UserName</td>
                <td>@x.BookTitle</td>
                <td>@x.DueDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td>@x.OverdueDays</td>
                <td class="text-end">@x.FineAmount.ToString("N0") đ</td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Không có phiếu quá hạn.</td></tr>
        }
        </tbody>
    </table>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Trước</a>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Sau</a>
            </li>
        </ul>
    </nav>
}
