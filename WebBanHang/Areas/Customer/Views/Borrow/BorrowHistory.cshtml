@model WebBanHang.Models.ViewModels.BorrowHistoryPageViewModel
@using WebBanHang.Models
@{
    ViewData["Title"] = "Lịch sử mượn sách";
    var p = Model.Page;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Lịch sử mượn sách</h3>
        <a class="btn btn-outline-primary btn-sm" asp-area="Customer" asp-controller="Borrow" asp-action="MyBorrows">Đang mượn</a>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Sách</th>
                        <th>Mã bản sao</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Phạt</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in p.Items)
                {
                    <tr>
                        <td><a asp-area="Customer" asp-controller="Borrow" asp-action="Detail" asp-route-id="@item.BorrowId">@item.BookTitle</a></td>
                        <td><code class="small">@(string.IsNullOrEmpty(item.CopyCode) ? "—" : item.CopyCode)</code></td>
                        <td>@item.BorrowDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@item.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            @switch (item.Status)
                            {
                                case BorrowStatus.Returned:
                                    <span class="badge bg-success">Đã trả</span>
                                    break;
                                case BorrowStatus.Overdue:
                                    <span class="badge bg-danger">Quá hạn</span>
                                    break;
                                case BorrowStatus.Borrowing:
                                    <span class="badge bg-primary">Đang mượn</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">@(item.FineAmount > 0 ? item.FineAmount.ToString("N0") + " đ" : "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (p.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(p.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Customer" asp-controller="Borrow" asp-action="BorrowHistory" asp-route-page="@(p.PageNumber - 1)">Trước</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@p.PageNumber / @p.TotalPages</span></li>
                <li class="page-item @(p.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Customer" asp-controller="Borrow" asp-action="BorrowHistory" asp-route-page="@(p.PageNumber + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
