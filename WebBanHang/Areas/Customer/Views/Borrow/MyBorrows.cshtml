@model IReadOnlyList<WebBanHang.Models.ViewModels.CustomerBorrowRowViewModel>
@using WebBanHang.Models
@{
    ViewData["Title"] = "Sách đang mượn";
}
<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0">Sách đang mượn</h3>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm" asp-area="Customer" asp-controller="Borrow" asp-action="BorrowHistory">Lịch sử</a>
            <a class="btn btn-outline-secondary btn-sm" asp-area="Customer" asp-controller="LibraryCard" asp-action="Index">Thẻ QR</a>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sách</th>
                        <th>Mã bản sao</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Còn lại</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Phí / Phạt</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-area="Customer" asp-controller="Borrow" asp-action="Detail" asp-route-id="@item.BorrowId">@item.BookTitle</a>
                        </td>
                        <td><code class="small">@(string.IsNullOrEmpty(item.CopyCode) ? "—" : item.CopyCode)</code></td>
                        <td>@item.BorrowDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@item.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.DaysRemaining.HasValue)
                            {
                                if (item.DaysRemaining < 0)
                                {
                                    <span class="text-danger">Trễ @(-item.DaysRemaining) ngày</span>
                                }
                                else
                                {
                                    <span>@item.DaysRemaining ngày</span>
                                }
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case BorrowStatus.Borrowing:
                                    <span class="badge bg-primary">Đang mượn</span>
                                    break;
                                case BorrowStatus.Overdue:
                                    <span class="badge bg-danger">Quá hạn</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end small">
                            <div>Phí mượn: @item.BorrowFeeAmount.ToString("N0") đ</div>
                            @if (item.FineAmount > 0)
                            {
                                <div class="text-danger">Phạt: @item.FineAmount.ToString("N0") đ (@item.OverdueDays ngày)</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Status is BorrowStatus.Borrowing or BorrowStatus.Overdue)
                            {
                                <form asp-area="Customer" asp-controller="Borrow" asp-action="ReturnBook" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="borrowId" value="@item.BorrowId" />
                                    <button class="btn btn-sm btn-primary rounded-pill" type="submit">Trả sách</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">Bạn chưa có sách đang mượn.</div>
        }
    </div>

    @if (Model.Any(m => m.Status is BorrowStatus.Borrowing or BorrowStatus.Overdue))
    {
        ViewData["QrReturnTitle"] = "Trả sách bằng QR";
        ViewData["QrReturnDescription"] = "Quét mã trên bản sao sách để trả nhanh. Bạn vẫn có thể dùng nút «Trả sách» theo từng dòng.";
        ViewData["QrReturnReloadOnSuccess"] = true;
        @await Html.PartialAsync("~/Areas/Customer/Views/Shared/_BookCopyQrReturnPanel.cshtml")
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script src="~/js/book-copy-qr-return.js" asp-append-version="true"></script>
    <script>window.bookCopyQrReturn.initAll();</script>
}
