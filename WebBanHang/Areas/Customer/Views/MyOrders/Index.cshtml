@model List<WebBanHang.Models.Order>
@using WebBanHang.Models
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    ViewData["CustomerNavSection"] = "cart";
    var pageIndex = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}
<div class="container mt-4">
    <h3 class="mb-3">Đơn hàng của tôi</h3>
    <div class="table-responsive card">
        <table class="table table-hover mb-0">
            <thead>
            <tr><th>Mã</th><th>Ngày</th><th>Tổng</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.TotalPrice.ToString("N0") đ</td>
                    <td>
                        @if (o.OrderStatus == OrderStatus.Pending)
                        { <span class="badge bg-warning text-dark">Chờ thanh toán</span> }
                        else if (o.OrderStatus == OrderStatus.Paid)
                        { <span class="badge bg-success">Đã thanh toán</span> }
                        else
                        { <span class="badge bg-secondary">@o.OrderStatus</span> }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@o.Id">Chi tiết</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(pageIndex <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex - 1)">Trước</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@pageIndex / @totalPages</span></li>
                <li class="page-item @(pageIndex >= totalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-page="@(pageIndex + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
