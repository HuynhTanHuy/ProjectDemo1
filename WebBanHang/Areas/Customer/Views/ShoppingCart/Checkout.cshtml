@model WebBanHang.Models.ViewModels.CheckoutOrderViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
<h2>Thanh toán</h2>
<div class="mb-3 text-muted small">
    Tạm tính: @Model.MerchandiseTotal.ToString("N0") đ &middot; Phí vận chuyển: @Model.ShippingCost.ToString("N0") đ
    &middot; <strong>Tổng: @Model.OrderTotal.ToString("N0") đ</strong>
</div>
<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group mb-3">
        <label asp-for="ShippingAddress" class="form-label"></label>
        <input asp-for="ShippingAddress" class="form-control" />
        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Tạo đơn và thanh toán</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
